*.pem
*.key
*.crt
*.pfx
*.p12
serviceAccountKey.json
serviceAccountKey*.json
*serviceAccount*.json
firebase-adminsdk*.json
google-credentials*.json
!serviceAccountKey.json.example

# ─── Python & Virtual Environments ───
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/

# ─── Machine Learning Weights & Pretrained Models ───
pretrained_models/
*.ckpt
*.pt
*.pth
*.bin
*.onnx

# ─── Audio & Media Temp Files ───
*.wav
*.mp3
*.ogg
*.webm
*.m4a
recordings/
temp_audio/

# ─── Logs & Databases ───
*.log
logs/
*.sqlite3
*.db
