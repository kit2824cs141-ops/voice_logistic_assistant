# OpenAI API Key for VoiceLog Assistant
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# N8N Webhook URL (for automation workflows)
# Test URL (requires clicking 'Execute Workflow' in n8n):
# N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook-test/logivoice"

# Production URL (always active after workflow is activated in n8n):
N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/logivoice"
